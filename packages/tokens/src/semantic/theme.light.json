{
  "$description": "Light theme. Values match BoardUI's light semantic tokens (styles/theme.css :root). The BoardUI name each token replaces is in $description.",
  "color": {
    "bg": {
      "canvas": {
        "$type": "color",
        "$value": "{color.paper.100}",
        "$description": "background-full"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.paper.50}",
        "$description": "background-primary-default"
      },
      "surface-hover": {
        "$type": "color",
        "$value": "{color.paper.100}",
        "$description": "background-primary-hover, dropdown-item-hover-background"
      },
      "surface-pressed": {
        "$type": "color",
        "$value": "{color.paper.200}",
        "$description": "background-primary-active"
      },
      "surface-disabled": {
        "$type": "color",
        "$value": "{color.paper.100}",
        "$description": "background-primary-disabled"
      },
      "sunken": {
        "$type": "color",
        "$value": "{color.paper.200}",
        "$description": "background-secondary-default"
      },
      "sunken-hover": {
        "$type": "color",
        "$value": "{color.paper.300}",
        "$description": "background-secondary-hover"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.paper.200}",
        "$description": "background-tertiary-default"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.paper.300}",
        "$description": "background-quaternary-default"
      },
      "muted-hover": {
        "$type": "color",
        "$value": "{color.paper.300}"
      },
      "strong-hover": {
        "$type": "color",
        "$value": "{color.paper.400}"
      },
      "danger-subtle": {
        "$type": "color",
        "$value": "{color.red.100}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.paper.950}",
        "$description": "text-primary"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.paper.600}",
        "$description": "text-secondary"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.paper.500}",
