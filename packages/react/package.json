{
  "name": "@windesign/react",
  "version": "0.1.0",
  "description": "Accessible React components on React Aria, styled through Windesign design tokens and Tailwind CSS v4.",
  "keywords": [
    "react",
    "design-system",
    "components",
    "react-aria",
    "tailwindcss",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdev-windesign/Design-System.git",
    "directory": "packages/react"
  },
  "homepage": "https://galactic-deepskyblue-toad-85.hostingersite.com",
  "bugs": {
    "url": "https://github.com/superdev-windesign/Design-System/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "windesign-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "vite build -c build.config.ts && tsc -p tsconfig.build.json",
    "prepack": "node ../../tools/release/copy-legal.mjs && npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "motion": "^12.42.2",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.17.0",
    "react-stately": "^3.51.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vite": "^7.3.0"
  }
}
