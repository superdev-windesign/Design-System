  "gradient": {
    "action": {
      "primary": {
        "default": {
          "$type": "gradient",
          "$value": "linear-gradient({color.paper.950}, {color.paper.950})"
        },
        "hover": {
          "$type": "gradient",
          "$value": "linear-gradient({color.paper.800}, {color.paper.800})"
        },
        "pressed": {
          "$type": "gradient",
          "$value": "linear-gradient({color.paper.900}, {color.paper.900})"
        },
        "disabled": {
          "$type": "gradient",
          "$value": "linear-gradient({color.paper.200}, {color.paper.200})"
        }
      },
      "danger": {
        "default": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.red.500} 0%, {color.red.600} 100%)"
        },
        "hover": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.red.400} 0%, {color.red.500} 100%)"
        },
        "pressed": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.red.600} 0%, {color.red.700} 100%)"
        },
        "disabled": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.red.100} 0%, {color.red.200} 100%)"
        }
      }
    }
  },
  "elevation": {
    "raised": {
      "$type": "shadow",
      "$value": "{shadow.rule}",
      "$description": "shadow-rule"
    },
    "overlay": {
      "$type": "shadow",
      "$value": "{shadow.float}",
      "$description": "shadow-float"
    },
    "hairline": {
      "$type": "shadow",
      "$value": "{shadow.rule}"
    },
    "control-checked": {
      "$type": "shadow",
      "$value": "inset 0 2px 0 0 rgb(255 255 255 / 0.25), inset 0 0 0 1px {color.accent.500}"
    }
  }
