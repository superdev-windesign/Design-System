      },
      "enter": {
        "$type": "cubicBezier",
        "$value": "{easing.emphasized}",
        "$description": "Decelerating entrances and state changes (BoardUI's signature curve)"
      },
      "out": {
        "$type": "cubicBezier",
        "$value": "{easing.decelerate}"
      },
      "ease": {
        "$type": "cubicBezier",
        "$value": "{easing.ease}"
      },
      "overshoot": {
        "$type": "cubicBezier",
        "$value": "{easing.overshoot}"
      }
    },
