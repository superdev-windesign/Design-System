      "$value": "{shadow.dropdown-strong}"
    },
    "hairline": {
      "$type": "shadow",
      "$value": "{shadow.2xs-strong}"
    },
    "control-checked": {
      "$type": "shadow",
      "$value": "inset 0 2px 0 0 rgb(255 255 255 / 0.25), inset 0 0 0 1px {color.accent.500}"
    }
