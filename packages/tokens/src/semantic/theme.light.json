        "$type": "color",
        "$value": "{color.red.500}"
      },
      "danger-placeholder": {
        "$type": "color",
        "$value": "{color.red.400}"
      },
      "placeholder": {
        "$type": "color",
        "$value": "{color.paper.500}",
        "$description": "text-placeholder (same value in dark)"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "{color.paper.950}",
        "$description": "foreground-icon-primary"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.paper.600}",
        "$description": "foreground-icon-secondary"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.paper.400}"
