{
  "$description": "Component-scoped tokens (light). Used by one component each.",
  "component": {
    "kbd": {
      "bg": {
        "$type": "color",
        "$value": "{color.paper.300}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.paper.500}"
      }
    },
    "avatar": {
      "bg": {
        "$type": "color",
        "$value": "{color.paper.300}"
      },
      "blue": {
        "bg": {
          "$type": "color",
          "$value": "{color.blue.300}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.blue.900}"
        }
      },
      "lime": {
        "bg": {
          "$type": "color",
          "$value": "{color.lime.200}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.lime.700}"
        }
      },
      "pink": {
        "bg": {
          "$type": "color",
          "$value": "{color.pink.200}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.pink.500}"
        }
      }
    },
    "badge-neutral": {
      "bg": {
        "$type": "color",
        "$value": "{color.paper.200}"
      }
    },
    "file-upload": {
      "icon-bg": {
        "$type": "color",
        "$value": "{color.paper.300}"
      },
      "icon-fg": {
        "$type": "color",
        "$value": "{color.paper.400}"
      },
      "icon-fg-hover": {
        "$type": "color",
        "$value": "{color.paper.500}"
      }
    },
    "pill-tab": {
      "selected-bg": {
        "$type": "color",
        "$value": "{color.accent.50}"
      },
      "hover-bg": {
        "$type": "color",
        "$value": "{color.paper.100}"
      }
    },
    "segmented": {
      "bg": {
        "$type": "color",
        "$value": "{color.paper.100}"
      },
      "selected-bg": {
        "$type": "color",
        "$value": "{color.paper.50}"
      }
    },
    "tab-count": {
      "bg": {
        "$type": "color",
        "$value": "color-mix(in srgb, {color.black} 10%, transparent)"
      },
      "selected-bg": {
        "$type": "color",
        "$value": "{color.accent.100}"
      }
    },
    "switch": {
      "off-start": {
        "$type": "color",
        "$value": "{color.paper.50}"
      },
      "off-end": {
        "$type": "color",
        "$value": "{color.paper.100}"
      },
      "on-start": {
        "$type": "color",
        "$value": "{color.accent.600}"
      },
      "on-end": {
        "$type": "color",
        "$value": "{color.accent.600}"
      },
      "on-sm": {
        "$type": "shadow",
        "$value": "inset 0 1px 0 0 rgb(255 255 255 / 0.25), inset 0 0 0 0.5px {color.accent.500}"
      },
      "on-md": {
        "$type": "shadow",
        "$value": "inset 0 1.5px 0 0 rgb(255 255 255 / 0.25), inset 0 0 0 0.75px {color.accent.500}"
      },
      "chip-sm": {
        "$type": "shadow",
        "$value": "0 2px 2px 0 rgb(0 0 0 / 0.03)"
      },
      "chip-md": {
        "$type": "shadow",
        "$value": "0 3px 3px 0 rgb(0 0 0 / 0.03)"
      },
      "chip-lg": {
        "$type": "shadow",
        "$value": "0 4px 4px 0 rgb(0 0 0 / 0.03)"
      },
      "thumb": {
        "$type": "shadow",
        "$value": "0 3px 3px 0 rgb(0 0 0 / 0.03), 0 0.75px 0 0 rgb(0 0 0 / 0.05)"
      }
    },
    "social": {
      "dark-bg": {
        "$type": "color",
        "$value": "{color.paper.950}"
      },
      "dark-bg-hover": {
        "$type": "color",
        "$value": "{color.paper.800}"
      },
      "dark-bg-pressed": {
        "$type": "color",
        "$value": "{color.paper.900}"
      }
    },
    "radio": {
      "checked-sm": {
        "$type": "shadow",
        "$value": "inset 0 0 0 0.875px {color.accent.500}, inset 0 1.75px 0 0 rgb(255 255 255 / 0.25)"
      },
      "checked-md": {
        "$type": "shadow",
        "$value": "inset 0 0 0 1px {color.accent.500}, inset 0 2px 0 0 rgb(255 255 255 / 0.25)"
      }
    },
    "slider": {
      "track": {
        "$type": "shadow",
        "$value": "inset 0 1px 1px rgb(0 0 0 / 0.06)"
      },
      "fill": {
        "$type": "shadow",
        "$value": "inset 0 1px 0 rgb(255 255 255 / 0.24), 0 1px 2px rgb(4 80 226 / 0.16)"
      },
      "thumb": {
        "$type": "shadow",
        "$value": "0 2px 4px rgb(0 0 0 / 0.10), inset 0 1px 0 rgb(255 255 255 / 0.8)"
      },
      "thumb-active": {
        "$type": "shadow",
        "$value": "0 3px 8px color-mix(in srgb, {color.accent.600} 22%, transparent)"
      },
      "highlight": {
        "$type": "shadow",
        "$value": "inset 0 1px 0 rgb(255 255 255 / 0.24)"
      }
    },
    "sidebar": {
      "panel": {
        "$type": "shadow",
        "$value": "0 1px 0 0 rgb(0 0 0 / 0.0196), 0 1px 12px 0 rgb(0 0 0 / 0.0588), 0 0 1px 0 rgb(0 0 0 / 0.3216)",
        "$description": "Floating app sidebar"
      },
      "nav-selected": {
        "$type": "shadow",
        "$value": "0 0 0 1px {color.accent.500}, inset 0 1px 0 0 rgb(255 255 255 / 0.251)",
        "$description": "Selected nav item on the accent gradient"
      },
      "avatar-bg": {
        "$type": "color",
        "$value": "{color.bg.muted}",
        "$description": "Flat sidebar profile avatar"
      }
    },
    "stat-card": {
      "icon": {
        "blue": {
          "start": {
            "$type": "color",
            "$value": "{color.blue.500}"
          },
          "end": {
            "$type": "color",
            "$value": "{color.blue.600}"
          }
        },
        "orange": {
          "start": {
            "$type": "color",
            "$value": "{color.orange.400}"
          },
          "end": {
            "$type": "color",
            "$value": "{color.orange.500}"
          }
        },
        "purple": {
          "start": {
            "$type": "color",
            "$value": "{color.purple.500}"
          },
          "end": {
            "$type": "color",
            "$value": "{color.purple.600}"
          }
        },
        "pink": {
          "start": {
            "$type": "color",
            "$value": "{color.pink.500}"
          },
          "end": {
            "$type": "color",
            "$value": "{color.pink.600}"
          }
        },
        "sky": {
          "start": {
            "$type": "color",
            "$value": "{color.sky.400}"
          },
          "end": {
            "$type": "color",
            "$value": "{color.sky.500}"
          }
        },
        "emerald": {
          "start": {
            "$type": "color",
            "$value": "{color.emerald.500}"
          },
          "end": {
            "$type": "color",
            "$value": "{color.emerald.600}"
          }
        }
      }
    },
    "plan-art": {
      "orange": {
        "$type": "color",
        "$value": "{color.orange.400}",
        "$description": "Decorative glow in the settings plan artwork"
      }
    },
    "auth-card": {
      "bg": {
        "$type": "color",
        "$value": "{color.bg.surface}",
        "$description": "Auth card surface (sits one step deeper in dark)"
      }
    }
  }
}
