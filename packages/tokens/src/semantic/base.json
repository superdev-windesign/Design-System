        "$description": "Button colors, popover enter/exit"
      },
      "moderate": {
        "$type": "duration",
        "$value": "{duration.200}",
        "$description": "Select trigger, chevron rotation, tooltip"
      },
      "slow": {
        "$type": "duration",
        "$value": "{duration.250}",
        "$description": "Footer summary slide-in"
      },
      "press-in": {
        "$type": "duration",
        "$value": "{duration.220}"
      },
      "press-out": {
        "$type": "duration",
        "$value": "{duration.420}"
      },
      "shimmer": {
        "$type": "duration",
        "$value": "{duration.3400}",
        "$description": "One sweep of the in-progress text shimmer"
      },
      "row-enter": {
        "$type": "duration",
        "$value": "{duration.400}",
        "$description": "A list row growing in and sliding from under the row above"
      },
      "row-exit": {
        "$type": "duration",
        "$value": "{duration.225}",
        "$description": "A list row collapsing away"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
