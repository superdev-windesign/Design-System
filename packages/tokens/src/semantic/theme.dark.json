  "gradient": {
    "action": {
      "primary": {
        "default": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.accent.500} 0%, {color.accent.600} 100%)"
        },
        "hover": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.accent.400} 0%, {color.accent.500} 100%)"
        },
        "pressed": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.accent.600} 0%, {color.accent.700} 100%)"
        },
        "disabled": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.neutral.700} 0%, {color.neutral.800} 100%)"
        }
      },
      "danger": {
        "default": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.red.500} 0%, {color.red.600} 100%)"
        },
        "hover": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.red.400} 0%, {color.red.500} 100%)"
        },
        "pressed": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.red.600} 0%, {color.red.700} 100%)"
        },
        "disabled": {
          "$type": "gradient",
          "$value": "linear-gradient(180deg, {color.red.900} 0%, {color.red.950} 100%)"
        }
      }
