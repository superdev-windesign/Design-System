{
  "name": "@windesign/playground",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "npm --prefix ../../packages/tokens run build",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc -p tsconfig.json && vite build",
    "postbuild": "node scripts/copy-dist-to-root.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@windesign/react": "0.1.0",
    "@windesign/styles": "0.1.0",
    "@windesign/tokens": "0.1.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@internationalized/date": "^3.12.1",
    "@remixicon/react": "^4.9.0",
    "react": "^19.2.0",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
